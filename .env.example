NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# Medusa admin credentials — power the shop dashboard Orders section
# (src/lib/medusa-admin.ts). Server-only; never exposed to the client. Set on
# the Coolify app for rollout web. Leave unset locally to disable the section.
MEDUSA_ADMIN_EMAIL=<medusa-admin-email>
MEDUSA_ADMIN_PASSWORD=<medusa-admin-password>
